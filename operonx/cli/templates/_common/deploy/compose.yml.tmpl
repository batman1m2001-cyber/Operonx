{{#deploy}}
# From the project folder: docker compose -f deploy/compose.yml up --build
services:
  {{dist}}:
    build:
      context: ..
      dockerfile: deploy/Dockerfile
    env_file:
      - path: ../.env  # the secrets: copy .env.example to .env
        required: false
{{#http}}
    ports:
      - "8000:8000"
    restart: unless-stopped
{{/http}}
    volumes:
      - ../data:/app/data
      - ../out:/app/out
{{/deploy}}
