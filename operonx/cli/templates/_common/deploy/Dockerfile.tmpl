{{#deploy}}
# From the project folder: docker compose -f deploy/compose.yml up --build
FROM python:3.12-slim
WORKDIR /app
COPY pyproject.toml operonx.toml resources.yaml ./
COPY app app
COPY src src
COPY data data
{{#web}}
COPY web web
{{/web}}
RUN pip install --no-cache-dir .
{{#http}}
EXPOSE 8000
CMD ["operonx", "serve"]
{{/http}}
{{^http}}
CMD ["operonx", "run", "{{job}}"]
{{/http}}
{{/deploy}}
