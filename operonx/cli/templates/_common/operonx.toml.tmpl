# Where the project is, and where its application is declared.
#
# The services and jobs are declared in Python in app/main.py (`APP`), next
# to the graphs they run; this file only points the CLIs at it.
# resources.yaml is the other half: what the project reaches out to
# (models, stores), by key.

[project]
name = "{{name}}"
src  = ["src", "."]     # import roots: the features and `app` import from here
app  = "app.main:APP"

[resources]
overlay = "resources.yaml"

# Which trace sinks every run goes to. "local" records each run under
# .operonx/runs.
[tracing]
sinks = ["local"]

# Run an op again when it fails for a moment (a timeout, a connection
# error, HTTP 429 or 5xx), in every job and request-reply service. A bug
# (a ValueError, a 400) is never retried. @op(retry=False) opts one op out,
# for one that must run once. Off until uncommented.
# [retry]
# max_attempts = 3   # attempts in all, the first included
# initial = 0.5      # seconds before the second attempt, doubling after
# max_interval = 30  # no pause longer than this
