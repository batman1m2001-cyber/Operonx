# Points the CLIs at `APP` in app/main.py; resources.yaml holds the models
# and stores, by key.

[project]
name = "{{name}}"
src  = ["src", "."]     # import roots: the features and `app` import from here
app  = "app.main:APP"
parts = {{parts}}   # what `operonx init` wrote; `operonx init . --web` adds a part

[resources]
overlay = "resources.yaml"

[tracing]   # "local": each run is recorded under .operonx/runs
sinks = ["local"]

# Retry an op that fails for a moment (timeout, 429, 5xx); never a bug.
# @op(retry=False) opts one op out. Guide page 06.
# [retry]
# max_attempts = 3   # attempts in all, the first included
# initial = 0.5      # seconds before the second attempt, doubling after
# max_interval = 30  # no pause longer than this
# transient = []    # your own errors worth another try, as "module:Name"

# Journal every step, so a failed run resumes where it stopped
# (operonx run NAME --resume) and a parked one is answered later. Guide page 08.
# [durable]
# journal = "sqlite:.operonx/journal.db"
