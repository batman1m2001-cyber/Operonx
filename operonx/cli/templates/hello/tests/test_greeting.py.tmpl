import asyncio

from operonx.app.jobs import Job

from greeting.graph import greet_flow
from greeting.ops import greet


def test_greet_titles_the_name():
    out = greet(person={"id": "a", "name": "  grace   hopper "})()
    assert out["result"] == {"id": "a", "greeting": "Hello, Grace Hopper!"}


def test_the_flow_greets_every_person(tmp_path):
    job = Job(
        "t",
        graph=greet_flow,
        items=[{"id": "a", "name": "ada"}, {"id": "b", "name": ""}],
        key="id",
        record_dir=tmp_path,
    )
    run = asyncio.run(job.run())
    assert run.status == "ok"
    assert run.results == {
        "a": {"id": "a", "greeting": "Hello, Ada!"},
        "b": {"id": "b", "greeting": "Hello, stranger!"},
    }
