"""The textstats feature's logic. Every op returns a dict literal: its keys
are the op's outputs."""

from operonx import op


@op
def clean(text: str) -> dict:
    """The text with its whitespace collapsed."""
    return {"text": " ".join(str(text).split())}


@op
def measure(text: str) -> dict:
    words = text.split()
    return {"words": len(words), "chars": len(text), "longest": max(words, key=len, default="")}
