"""The textstats feature's wiring: no logic here, only ops and edges."""

from operonx import END, START, graph

from textstats.ops import clean, measure


@graph
def stats_flow(text):  # served: the JSON body's `text`; the reply is measure's outputs
    c = clean(text=text)
    m = measure(text=c["text"])
    START >> c >> m >> END
