"""{{name}}: one HTTP service.

POST /stats:8000 {"text": ...} ──► stats_flow ──► {words, chars, longest}

Every service and job of the project is declared here; operonx.toml only
points at `APP`.
"""

from operonx.app import Application, Service, env, http

from textstats.graph import stats_flow

APP = Application(
    "{{name}}",
    description="{{summary}}",
    services=[
        Service(
            "stats",
            http("POST", "/stats", port=env("PORT", 8000)),
            graph=stats_flow,
            description="POST {text}, get {words, chars, longest}.",
        )
    ],
)
