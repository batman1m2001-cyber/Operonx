"""The chat feature: its logic (ops) and its wiring (a graph).

app/chat.py says who runs it (a job{{#http}}, a route{{/http}}). Split this file into a
src/chat/ folder only when it passes ~300 lines (AGENTS.md says how)."""

from operonx import END, START, graph, op
from operonx.prompts import prompt
from operonx.providers.ops import LLMOp

from _shared.config import ROOT

# the text is prompts/chat/system.md; `operonx prompt publish chat/system` keeps its versions
SYSTEM = prompt("chat/system", root=ROOT)


@op
def clean(question: str) -> dict:
    """The question with its whitespace collapsed. Every op returns a dict
    literal: its keys are the op's outputs."""
    return {"question": " ".join(str(question).split())}


@op
def reply(content: str = None, error: str = None) -> dict:
    """The answer to send back; a failed model call says so instead."""
    if content is None:
        return {"answer": None, "error": error or "the model gave no answer"}
    return {"answer": content, "error": None}


@graph
def chat_flow(question):  # a job item or a request body fills it; the reply is {answer, error}
    q = clean(question=question)  # a graph only wires: no logic, no I/O
    llm = LLMOp.of(
        resource="assistant",  # `llm:assistant` in resources.yaml
        prompt={"system": SYSTEM, "user": "{question}"},
        question=q["question"],  # every other keyword fills the template
    )
    r = reply(content=llm["content"], error=llm["error"])
    START >> q >> llm >> r >> END
