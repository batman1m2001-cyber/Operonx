"""{{name}}: one HTTP service in front of a ReAct agent.

POST /ask:8000 {"question": ...} ──► assistant_flow ──► {answer, stopped_early}
                                        └── agent: llm:assistant ⇄ word_count tool

Every service and job of the project is declared here; operonx.toml only
points at `APP`.
"""

from operonx.app import Application, Service, env, http

from assistant.graph import assistant_flow

APP = Application(
    "{{name}}",
    description="{{summary}}",
    services=[
        Service(
            "assistant",
            http("POST", "/ask", port=env("PORT", 8000)),
            graph=assistant_flow,
            description="POST {question}, get the agent's {answer, stopped_early}.",
        ),
        # The same agent on an event nobody waits for (a new email, a Slack
        # message): a webhook answers 202 at once and the run goes on in the
        # background. Add `webhook` to the import above to turn it on.
        #
        # Service(
        #     "assistant_events",
        #     webhook("/events", port=env("PORT", 8000)),
        #     graph=assistant_flow,
        #     max_inflight=16,  # answer 429 beyond 16 pending runs
        # ),
    ],
)
