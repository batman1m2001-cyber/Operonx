"""The assistant feature's wiring: no logic here, only ops and edges."""

from operonx import END, START, graph
from operonx.agents import AgentOp

from assistant.agent import ASSISTANT
from assistant.ops import reply


@graph
def ask_flow(input):  # a job item fills it; the reply is {output, status, error}
    answered = AgentOp.of(agent=ASSISTANT, input=input)
    r = reply(output=answered["output"], status=answered["status"], error=answered["error"])
    START >> answered >> r >> END
