# Operonx Environment Variables
# Copy this file to .env and fill in your values, then call
# `operonx.bootstrap()` at process startup to load it (Operon(graph) does not
# auto-load .env — bootstrap is explicit). Existing env vars are preserved.

# =============================================================================
# LLM Providers
# =============================================================================

# OpenAI
OPENAI_API_KEY=sk-...

# OpenRouter (access multiple models via single API)
OPENROUTER_API_KEY=sk-or-...

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Google AI (Gemini)
GOOGLE_API_KEY=

# Azure OpenAI
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/

# AWS Bedrock
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# =============================================================================
# Embedding Providers
# =============================================================================

# OpenAI embeddings use OPENAI_API_KEY above

# Cohere
COHERE_API_KEY=

# Voyage AI
VOYAGE_API_KEY=

# =============================================================================
# Observability
# =============================================================================

# Langfuse (recommended for tracing)
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com

# =============================================================================
# Operonx Configuration
# =============================================================================

# Directory for local traces (one JSON file per request). Optional.
# OPERON_TRACES_DIR=~/.operonx/traces

# =============================================================================
# Logging
# =============================================================================

# Log level: DEBUG, INFO, WARNING, ERROR
# LOG_LEVEL=INFO

# Use rich formatting for logs
# LOG_USE_RICH=true
