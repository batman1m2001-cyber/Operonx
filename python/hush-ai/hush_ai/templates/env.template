# Hush Environment Variables
# Fill in your API keys below. Referenced by resources.yaml via ${VAR_NAME}.

# =============================================================================
# LLM Providers
# =============================================================================

# OpenAI (required for gpt-4o, gpt-4o-mini, embeddings)
OPENAI_API_KEY=

# OpenRouter (access multiple models via single API)
OPENROUTER_API_KEY=

# Anthropic (Claude)
ANTHROPIC_API_KEY=

# Google AI (Gemini)
GOOGLE_API_KEY=

# Azure OpenAI
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=

# AWS Bedrock
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# DeepInfra (for BGE-M3 embeddings)
DEEPINFRA_API_KEY=

# =============================================================================
# Embedding & Reranking Providers
# =============================================================================

# Cohere (reranking)
COHERE_API_KEY=

# Pinecone (reranking)
PINECONE_API_KEY=

# Voyage AI (embeddings)
VOYAGE_API_KEY=

# =============================================================================
# Observability
# =============================================================================

# Langfuse (recommended for tracing)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# =============================================================================
# Hush Configuration
# =============================================================================

# Path to resources.yaml (optional, defaults to ./resources.yaml)
# HUSH_CONFIG=/path/to/resources.yaml

# Path to local traces database (optional)
# HUSH_TRACES_DB=~/.hush/traces.db

# Log level: DEBUG, INFO, WARNING, ERROR
# LOG_LEVEL=INFO
